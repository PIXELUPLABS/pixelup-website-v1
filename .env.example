NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-05

# Browser-safe project coordinates used by the standalone Sanity Studio.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Keep `legacy` until the migration validation passes, then switch to `sanity`.
SANITY_BLOG_SOURCE=legacy

# Server-only Sanity Viewer token used for private content queries and draft previews.
SANITY_API_READ_TOKEN=

# Shared secret used by the signed Sanity publication webhook.
SANITY_REVALIDATE_SECRET=

# Used by the standalone Studio Presentation tool.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Website Leads Google Sheet (Book a call + newsletter tabs) via an Apps Script
# web app. Setup steps are at the top of scripts/apps-script/WebsiteLeads.gs.
LEADS_SHEET_WEBHOOK_URL=
LEADS_SHEET_WEBHOOK_SECRET=

# Partner applications (/referral) → Google Sheet, via the Apps Script web app
# in scripts/google-sheets/referral-apps-script.gs. Server-only.
REFERRAL_SHEET_WEBHOOK_URL=
# Must match the SHARED_SECRET script property set in that Apps Script project.
REFERRAL_SHEET_SECRET=
